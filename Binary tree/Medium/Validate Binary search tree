/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    public boolean isValidBST(TreeNode root) {
        // Initialize with global boundary values to avoid integer overflow issues
        return validate(root, Long.MIN_VALUE, Long.MAX_VALUE);
    }

    private boolean validate(TreeNode node, long min, long max) {
        // An empty tree/node is a valid BST
        if (node == null) {
            return true;
        }

        // Current node's value must strictly fall within the min and max limits
        if (node.val <= min || node.val >= max) {
            return false;
        }

        // Left child must be less than current node value (updates upper bound)
        // Right child must be greater than current node value (updates lower bound)
        return validate(node.left, min, node.val) && validate(node.right, node.val, max);
    }
}
