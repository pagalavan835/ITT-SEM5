class Solution {
    private ListNode headPointer;
    public TreeNode sortedListToBST(ListNode head) {
        if (head == null) {
            return null;
        }
        int size = countNodes(head);
        this.headPointer = head;
        return convertToBST(0, size - 1);
    }
    private int countNodes(ListNode node) {
        int count = 0;
        while (node != null) {
            count++;
            node = node.next;
        }
        return count;
    }
    private TreeNode convertToBST(int left, int right) {
        if (left > right) {
            return null;
        }
        int mid = left + (right - left) / 2;
        TreeNode leftChild = convertToBST(left, mid - 1);
        TreeNode root = new TreeNode(this.headPointer.val);
        root.left = leftChild;
        this.headPointer = this.headPointer.next;
        root.right = convertToBST(mid + 1, right);
        return root;
    }
}
