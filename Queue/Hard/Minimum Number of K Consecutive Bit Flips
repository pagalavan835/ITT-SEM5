class Solution {
    public int minKBitFlips(int[] nums, int k) {
        int n = nums.length;
        int flips = 0;
        int currentFlips = 0;

        for (int i = 0; i < n; i++) {
            if (i >= k && nums[i - k] == 2) {
                currentFlips--;
            }

            if ((nums[i] + currentFlips) % 2 == 0) {
                if (i + k > n) {
                    return -1;
                }
                nums[i] = 2;
                currentFlips++;
                flips++;
            }
        }

        return flips;
    }
}
